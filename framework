#!/usr/bin/env python3

import argparse
import json
import os
import secrets
import sys
import time
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

from framework_cli.runtime import DockerRuntime, RuntimeFailure, workspace_root
from framework_cli.spec import SpecError, load_run_spec


def add_output_option(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true", dest="as_json")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="framework")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("preflight", "start", "stop", "status"):
        command = commands.add_parser(name)
        command.add_argument("--run-spec", required=True)
        add_output_option(command)

    local = commands.add_parser("local-test")
    local.add_argument(
        "--profile",
        required=True,
        choices=("inference-smoke", "training", "model-evaluation"),
    )
    local.add_argument("--learner-image-tag", default="training-001")
    local.add_argument("--aiserver-image-tag", default="training-001")
    local.add_argument("--client-image-tag", default="training-001")
    local.add_argument("--agents", type=int)
    local.add_argument("--episodes", type=int)
    local.add_argument("--max-steps", type=int)
    local.add_argument("--model-path")
    local.add_argument("--initial-checkpoint")
    local.add_argument("--keep-running", action="store_true")
    add_output_option(local)
    return parser


def local_test_spec(args: argparse.Namespace) -> Path:
    defaults = {
        "inference-smoke": (1, 1, 4),
        "training": (4, 3, 256),
        "model-evaluation": (1, 1, 4),
    }
    default_agents, default_episodes, default_steps = defaults[args.profile]
    agents = default_agents if args.agents is None else args.agents
    episodes = default_episodes if args.episodes is None else args.episodes
    max_steps = default_steps if args.max_steps is None else args.max_steps
    if agents <= 0 or episodes <= 0 or max_steps <= 0:
        raise SpecError("agents, episodes, and max-steps must be positive")
    if args.profile == "model-evaluation" and not args.model_path:
        raise SpecError("--model-path is required for model-evaluation")
    if args.initial_checkpoint and args.profile != "training":
        raise SpecError(
            "--initial-checkpoint is supported only for training"
        )

    timestamp = datetime.now(ZoneInfo("Asia/Shanghai")).strftime(
        "%Y%m%d-%H%M%S"
    )
    suffix = f"{secrets.randbelow(10000):04d}"
    task_id = f"local-{args.profile}-{timestamp}-{suffix}"
    run_id = f"{task_id}-run-0001"
    document = {
        "task_id": task_id,
        "run_id": run_id,
        "attempt": 1,
        "mode": args.profile,
        "agents": agents,
        "episodes": episodes,
        "max_steps": max_steps,
        "images": {
            "learner": args.learner_image_tag,
            "aiserver": args.aiserver_image_tag,
            "client": args.client_image_tag,
        },
    }
    if args.model_path:
        document["model_path"] = str(
            Path(args.model_path).expanduser().resolve()
        )
    if args.initial_checkpoint:
        document["initial_checkpoint"] = str(
            Path(args.initial_checkpoint).expanduser().resolve()
        )

    run_root = (
        workspace_root()
        / ".workspace/runtime/local-tests"
        / run_id
    )
    run_root.mkdir(parents=True, exist_ok=False)
    path = run_root / "run-spec.json"
    temporary = run_root / f".run-spec.{os.getpid()}.tmp"
    temporary.write_text(
        json.dumps(document, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    os.replace(temporary, path)
    return path


def execute(args: argparse.Namespace) -> dict:
    if args.command == "local-test":
        spec_path = local_test_spec(args)
        spec = load_run_spec(str(spec_path))
        runtime = DockerRuntime(spec, runtime_scope="local-tests")
        started_at = time.time()
        try:
            result = runtime.start()
        except Exception as exc:
            runtime._atomic_json(
                runtime.run_root / "acceptance.json",
                {
                    "schema_version": 1,
                    "ok": False,
                    "profile": args.profile,
                    "task_id": spec.task_id,
                    "run_id": spec.run_id,
                    "started_at": started_at,
                    "completed_at": time.time(),
                    "error": str(exc),
                },
            )
            raise
        acceptance = {
            "schema_version": 1,
            "ok": True,
            "profile": args.profile,
            "task_id": spec.task_id,
            "run_id": spec.run_id,
            "started_at": started_at,
            "completed_at": time.time(),
            "keep_running": bool(args.keep_running),
            "result": result,
        }
        runtime._atomic_json(runtime.run_root / "acceptance.json", acceptance)
        if not args.keep_running:
            acceptance["cleanup"] = runtime.stop()
            acceptance["cleaned_up"] = True
            runtime._atomic_json(
                runtime.run_root / "acceptance.json", acceptance
            )
        else:
            acceptance["cleaned_up"] = False
        return acceptance

    spec = load_run_spec(args.run_spec)
    runtime_scope = (
        "local-tests"
        if spec.source_path.parent.parent.name == "local-tests"
        else "runs"
    )
    runtime = DockerRuntime(spec, runtime_scope=runtime_scope)
    if args.command == "preflight":
        return runtime.preflight()
    if args.command == "start":
        return runtime.start()
    if args.command == "stop":
        return runtime.stop()
    return runtime.status()


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        result = execute(args)
    except (SpecError, RuntimeFailure, OSError, ValueError) as exc:
        error = {
            "schema_version": 1,
            "ok": False,
            "command": args.command,
            "error": str(exc),
        }
        if args.as_json:
            print(json.dumps(error, ensure_ascii=False, separators=(",", ":")))
        else:
            print(f"error: {exc}", file=sys.stderr)
        return 1

    if args.as_json:
        print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    else:
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
